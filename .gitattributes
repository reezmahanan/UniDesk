# GitHub Linguist overrides
# Force GitHub to detect Vue.js and Python correctly

# Vue single-file components → Vue
*.vue linguist-language=Vue

# TypeScript → TypeScript
*.ts linguist-language=TypeScript

# Python files
*.py linguist-language=Python

# ── Exclude legacy root files (old vanilla JS prototype) ──────────────────────
# These are the old Apex-Bot HTML/JS/CSS files kept for reference only
app.js              linguist-vendored=true
chatbot-data.js     linguist-vendored=true
index.html          linguist-vendored=true
styles.css          linguist-vendored=true

# ── Exclude generated / config boilerplate ────────────────────────────────────
package-lock.json                   linguist-generated=true
frontend/package-lock.json          linguist-generated=true
frontend/index.html                 linguist-generated=true
*.config.js                         linguist-generated=true
*.config.ts                         linguist-generated=true
tailwind.config.js                  linguist-generated=true
postcss.config.js                   linguist-generated=true
vite.config.ts                      linguist-generated=true
vite.config.js                      linguist-generated=true
tsconfig*.json                      linguist-generated=true

# ── Exclude dist/build output ─────────────────────────────────────────────────
frontend/dist/**                    linguist-generated=true
