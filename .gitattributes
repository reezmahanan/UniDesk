# GitHub Linguist overrides
# Tell GitHub which languages are actually used

# ── Core languages ─────────────────────────────────────────────────────────────
*.vue       linguist-language=Vue        linguist-detectable=true
*.py        linguist-language=Python     linguist-detectable=true
*.ts        linguist-language=TypeScript linguist-detectable=true

# ── Exclude legacy root files (old vanilla JS prototype) ──────────────────────
app.js              linguist-vendored=true
chatbot-data.js     linguist-vendored=true
index.html          linguist-vendored=true
styles.css          linguist-vendored=true

# ── Exclude CSS (single stylesheet, not meaningful as a language) ─────────────
frontend/src/styles/main.css    linguist-vendored=true

# ── Exclude generated / config / build files ─────────────────────────────────
package-lock.json                       linguist-generated=true
frontend/package-lock.json              linguist-generated=true
frontend/index.html                     linguist-generated=true
frontend/vite.config.js                 linguist-generated=true
frontend/vite.config.d.ts               linguist-generated=true
frontend/postcss.config.js              linguist-generated=true
frontend/tailwind.config.js             linguist-generated=true
frontend/tsconfig.json                  linguist-generated=true
frontend/tsconfig.node.json             linguist-generated=true
frontend/tsconfig.tsbuildinfo           linguist-generated=true
frontend/tsconfig.node.tsbuildinfo      linguist-generated=true
*.tsbuildinfo                           linguist-generated=true
*.d.ts                                  linguist-generated=true
frontend/dist/**                        linguist-generated=true

# ── Exclude docs/config formats ──────────────────────────────────────────────
*.md                linguist-documentation=true
*.txt               linguist-documentation=true
*.ini               linguist-documentation=true
*.yml               linguist-documentation=true
*.yaml              linguist-documentation=true
*.json              linguist-generated=true
Dockerfile          linguist-vendored=true
*.conf              linguist-vendored=true
.env.example        linguist-vendored=true
