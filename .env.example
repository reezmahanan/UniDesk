# =================================================================
# APEX — AI University Help Desk & Ticketing Platform Environment Config
# =================================================================

# Database (PostgreSQL with pgvector or SQLite for local dev)
DATABASE_URL=postgresql://apex_user:apex_secure_password_2026@localhost:5432/apex_university_db
# For SQLite local development:
# DATABASE_URL=sqlite:///./apex_dev.db

# Security & Authentication
SECRET_KEY=replace-with-a-random-64-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Generation & Grounded RAG
# Leave MOCK_AI_MODE=true for local testing without external API credentials.
# Set MOCK_AI_MODE=false and provide GEMINI_API_KEY for live Google Gemini models.
MOCK_AI_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Document Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# File Storage Limits
UPLOAD_DIR=./storage/uploads
DOCUMENTS_DIR=./storage/documents
MAX_FILE_SIZE_BYTES=10485760

# Rate Limits (Requests per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=20
